{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sojka.pro/schemas/raw-to-pro/prompt-types.schema.json",
  "title": "RAW → PRO prompt type registry",
  "type": "object",
  "required": ["version", "types"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "required_sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "required_sections": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
